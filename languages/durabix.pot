msgstr ""

#: src/Admin/SettingsPage.php:105
msgid "Checkout"
msgstr ""

#: src/Admin/SettingsPage.php:109
msgid "Show the notice above the place order button, classic and block checkout"
msgstr ""

#: src/Admin/SettingsPage.php:114
